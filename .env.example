# WhatsCircle Environment Configuration

# Server Port (Default: 3000)
PORT=3000

# App URL (Injected automatically in AI Studio / Cloud Run)
APP_URL="http://localhost:3000"

# Admin Authentication (Change these before deploying to production!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="SecretCirclePassword2026!"

# JWT Secret for Admin Session Tokens (Auto-generated fallback if omitted)
ADMIN_JWT_SECRET="whatscircle-jwt-super-secret-key-change-me"

# SQLite Database File Path (Default: ./data/whatscircle.db)
DATABASE_PATH="./data/whatscircle.db"

# Gemini API Key (if optional AI utilities are used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
